# Without NEWSDATA_API_KEY the app shows labelled SAMPLE data. Set USE_GDELT=1 to try GDELT instead.
# Optional AI brief. Without a key the app shows a plain headline list.
# Gemini API free (unpaid) quota, OpenAI-compatible endpoint. Only public headlines are sent.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# Recommended news source: NewsData.io free plan (key from newsdata.io). Falls back to GDELT if unset.
NEWSDATA_API_KEY=
